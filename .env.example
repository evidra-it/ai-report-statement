# Server
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-this-secret-in-production

# Database
# Persist data across redeploys. On Render, create a managed PostgreSQL and paste its
# "Internal Database URL" here (survives deploys). Omit/unset to use a local SQLite file
# (data/forensic.db), suitable for local dev but WIPED on Render redeploys.
DATABASE_URL=

# Superadmin (seeded on first run)
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=superadmin@123

# Email via Nodemailer / SMTP (leave SMTP_HOST empty to use mock mode)
# Mock mode prints the link to the console and saves a preview in ./emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@yourdomain.com
FROM_NAME="Forensic Investigation Portal"
# Brevo transactional email API (HTTPS, port 443) - use on Render where SMTP 587 is often blocked.
# Key from Brevo -> SMTP & API -> API Keys (starts with xkeysib-...). Takes priority over SMTP when set.
BREVO_API_KEY=

# AI models via OpenRouter (comma-separated fallback list, tried in order)
# Free models e.g. nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_API_KEY=
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free,openai/gpt-oss-20b:free,google/gemma-4-31b-it:free
